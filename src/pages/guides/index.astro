---
import Base from '../../layouts/Base.astro';
import ResourceExplorer from '../../components/ResourceExplorer.astro';
import GoalFinder from '../../components/GoalFinder.astro';
import { visible, entryPath } from '../../lib/content';
const entries = (await visible()).filter(entry=>entry.data.category==='guide');
const topicsById:Record<string,string>={
  'compare-college-financial-aid-offers':'college',
  'understand-college-aid-types':'college',
  'compare-student-loan-repayment':'repayment',
  'student-loan-interest-explained':'repayment',
  'prepare-for-student-loan-repayment':'repayment',
  'pslf-payment-count-checklist':'forgiveness',
};
const order=[
  'compare-college-financial-aid-offers',
  'understand-college-aid-types',
  'compare-student-loan-repayment',
  'student-loan-interest-explained',
  'prepare-for-student-loan-repayment',
  'pslf-payment-count-checklist'
];
const introductions:Record<string,{title:string;forYou:string;outcome:string}>={
  'compare-college-financial-aid-offers':{
    title:'Which college offer will cost me less?',
    forYou:'You have costs and award letters for two schools.',
    outcome:'A practical net-price comparison and what to ask each school.'
  },
  'understand-college-aid-types':{
    title:'Which parts of my aid offer are grants, loans or work-study?',
    forYou:'An award letter has terms you do not recognize.',
    outcome:'A simple breakdown and a worked $32,000 example.'
  },
  'compare-student-loan-repayment':{
    title:'Is the lowest monthly payment the cheapest option?',
    forYou:'You are considering different repayment scenarios.',
    outcome:'Four figures to compare and an easy cost example.'
  },
  'student-loan-interest-explained':{
    title:'Why am I paying interest on my student loan?',
    forYou:'You see interest or APR on a statement and are unsure what it means.',
    outcome:'A daily-interest example and what affects the actual amount.'
  },
  'prepare-for-student-loan-repayment':{
    title:'What should I do before my first loan bill?',
    forYou:'You are starting repayment or checking your account.',
    outcome:'A step-by-step checklist and which documents to collect.'
  },
  'pslf-payment-count-checklist':{
    title:'How do I check which PSLF payments count?',
    forYou:'You have public-service employment or an official PSLF count.',
    outcome:'What 120 means, how to read your count and when to seek review.'
  },
};
const resources=entries.map(entry=>({
  href:entryPath(entry),
  title:introductions[entry.id]?.title??entry.data.title,
  description:entry.data.description,
  forYou:introductions[entry.id]?.forYou??'You want an explanation of this topic.',
  outcome:introductions[entry.id]?.outcome??'Context, examples and links to official sources.',
  topic:topicsById[entry.id]??'repayment',
  kind:topicsById[entry.id]==='college'?'College costs':topicsById[entry.id]==='forgiveness'?'Forgiveness':'Repayment',
  detail:'Step-by-step guide',
  featured:order.slice(0,3).includes(entry.id),
})).sort((a,b)=>{
  const aIndex=order.indexOf(a.href.split('/').filter(Boolean).at(-1)??'');
  const bIndex=order.indexOf(b.href.split('/').filter(Boolean).at(-1)??'');
  return (aIndex<0?999:aIndex)-(bIndex<0?999:bIndex);
});
const topics=[{value:'college',label:'Choosing a college'},{value:'repayment',label:'Paying back loans'},{value:'forgiveness',label:'Forgiveness'}];
---
<Base title="Student Loan and College Financial Aid Guides" description="Browse practical guides about college financial aid, loan interest, repayment costs, PSLF progress and decisions to verify with official sources." og="guides">
  <header class="resource-hero resource-hero-slim">
    <div class="resource-hero-copy">
      <span class="eyebrow">LoanLens learning center</span>
      <h1>Clear answers to the questions you actually have.</h1>
      <p>No jargon required. Tell us what confuses you—interest, financial aid, monthly bills or PSLF—and find an explanation you can use today.</p>
      <div class="hero-actions">
        <a class="primary button-link" href="#find-my-guide">Help me choose a guide</a>
        <a class="secondary button-link" href="/tools/">Explore tools instead</a>
      </div>
      <p class="hero-microcopy">Plain language · Worked examples · Sources you can check</p>
    </div>
  </header>

  <GoalFinder id="find-my-guide" mode="guides"/>

  <section class="resource-section" aria-labelledby="learning-paths">
    <div class="resource-section-head">
      <div><span class="eyebrow">Guided paths</span><h2 id="learning-paths">Start where you are.</h2></div>
      <p>These paths connect one useful explanation to the next action. You do not need to know loan terminology to begin.</p>
    </div>
    <div class="resource-path-grid">
      <a class="resource-path" href="/guides/understand-college-aid-types/"><span class="resource-path-index">01 / Before borrowing</span><strong>Reading a financial aid letter</strong><span>Understand what is free aid, earned aid and money to repay.</span><span class="resource-path-arrow">Start learning ↗</span></a>
      <a class="resource-path" href="/guides/compare-student-loan-repayment/"><span class="resource-path-index">02 / Repaying</span><strong>Choosing how to compare plans</strong><span>Look beyond the first monthly payment to the total projected cost.</span><span class="resource-path-arrow">Start learning ↗</span></a>
      <a class="resource-path" href="/guides/pslf-payment-count-checklist/"><span class="resource-path-index">03 / Forgiveness</span><strong>Checking PSLF progress</strong><span>Understand what your official count does—and does not—confirm.</span><span class="resource-path-arrow">Start learning ↗</span></a>
    </div>
  </section>

  <section id="browse-guides" class="resource-section" aria-labelledby="browse-guides-title">
    <div class="resource-section-head">
      <div><span class="eyebrow">Explore all explanations</span><h2 id="browse-guides-title">Browse every guide</h2></div>
      <p>Already know your topic? Search the whole library. Every card tells you whether it fits your question and what you will learn.</p>
    </div>
    <ResourceExplorer label="Search LoanLens guides" items={resources} topics={topics} placeholder="Try: interest, scholarships, monthly cost, PSLF…" />
  </section>

  <section class="resource-split" aria-labelledby="guides-apply-title">
    <div>
      <span class="eyebrow">Turn learning into action</span>
      <h2 id="guides-apply-title">An explanation is more useful with the right tool.</h2>
      <p>Work through a hypothetical example first. Use your actual records only when you understand what the input means.</p>
    </div>
    <div class="resource-prep-grid">
      <article class="resource-prep"><strong>Compare two colleges</strong><p>See annual net price, how much you plan to borrow and the remaining funding gap.</p><a href="/tools/compare-college-aid-offers/">Open college aid comparison</a></article>
      <article class="resource-prep"><strong>Compare repayment costs</strong><p>Model starting payments, timelines and long-term costs with consistent inputs.</p><a href="/calculator/">Open repayment calculator</a></article>
    </div>
  </section>

  <section class="resource-note">
    <strong>Information, not official loan advice.</strong>
    <p>Student loan rules and your personal eligibility can change. These articles explain concepts and the limitations of the estimates; verify decisions using <a href="https://studentaid.gov/">Federal Student Aid</a> or your loan servicer.</p>
  </section>
</Base>
