---
import Base from '../layouts/Base.astro';
import CalculatorPage from '../components/CalculatorPage.astro';
import AidPreview from '../components/AidPreview.astro';

const title = 'Student Loan Calculator & College Aid Comparison';
const description = 'Estimate federal student loan payments, compare repayment plans and see what college costs after grants and scholarships. Free tools with no sign-up.';
---
<Base {title} {description} kind="WebApplication">
  <header class="planning-hero">
    <div class="planning-intro">
      <h1>What will you <em>actually pay?</em></h1>
      <p>See what college costs after aid, or compare monthly payments on the federal student loans you already have.</p>
      <a class="primary button-link" href="#repayment-estimator">Estimate loan payments</a>
      <a class="aid-link" href="/tools/compare-college-aid-offers/">Choosing a college? Compare aid offers</a>
    </div>
    <AidPreview />
  </header>
  <nav class="quick-routes" aria-label="More ways to plan">
    <a href="/deadlines/"><strong>Repayment deadlines</strong><span>Find the dates for your plan</span></a>
    <a href="/tools/pslf-payment-tracker/"><strong>Public service forgiveness</strong><span>Check your remaining payments</span></a>
    <a href="/guides/"><strong>Student loan guides</strong><span>Understand your options</span></a>
  </nav>
  <CalculatorPage title="Student loan repayment calculator" embedded />
</Base>
