---
import Base from '../../layouts/Base.astro';
import ResourceExplorer from '../../components/ResourceExplorer.astro';
import GoalFinder from '../../components/GoalFinder.astro';
const resources = [
  {href:'/tools/compare-college-aid-offers/',title:'Which college will cost me less?',description:'Compare two offer letters without treating loans as free aid.',forYou:'You have offers from two schools.',outcome:'Annual net price, loans and funding gap side by side.',kind:'College costs',detail:'Side-by-side comparison',action:'Compare two offers',topic:'college',featured:true},
  {href:'/calculator/',title:'What might my monthly payment be?',description:'Compare projected payments and full repayment cost—not just the starting amount.',forYou:'You have a loan balance and interest rate.',outcome:'Estimated payments, total paid, time and assumptions.',kind:'Repayment',detail:'Three-step calculator',action:'Estimate loan payments',topic:'repayment',featured:true},
  {href:'/rap-payment-by-income/',title:'How does income affect RAP estimates?',description:'See sample payments across income ranges and dependent counts.',forYou:'You want to understand the RAP formula.',outcome:'A sample-income table with monthly estimates.',kind:'Repayment',detail:'Income reference table',action:'Explore RAP by income',topic:'repayment'},
  {href:'/tools/married-rap-impact/',title:'Does my spouse’s income change this estimate?',description:'Compare illustrative RAP payments under different household assumptions.',forYou:'You and your spouse have income or loan debt.',outcome:'A side-by-side modeled household comparison.',kind:'Household',detail:'Two-scenario estimate',action:'Compare household estimates',topic:'repayment'},
  {href:'/deadlines/',title:'What deadline should I check?',description:'Use the date from your repayment notice to explore a possible deadline.',forYou:'You received a notice or are changing plans.',outcome:'A calculated date to verify in your real notice.',kind:'Timeline',detail:'Date helper',action:'Check a notice date',topic:'repayment'},
  {href:'/tools/pslf-payment-tracker/',title:'How far am I from 120 PSLF payments?',description:'See a projected milestone using an official count for one loan.',forYou:'You already have a certified PSLF count.',outcome:'Remaining payment periods and target month.',kind:'Forgiveness',detail:'Milestone tracker',action:'Track PSLF progress',topic:'forgiveness'},
  {href:'/tools/parent-plus-consolidation-checker/',title:'Which Parent PLUS questions should I ask?',description:'Understand what consolidation dates and payment history to verify.',forYou:'You have Parent PLUS or consolidation history.',outcome:'A practical checklist for your loan servicer.',kind:'Special cases',detail:'Guided checklist',action:'Check Parent PLUS options',topic:'special'},
];
const topics=[
  {value:'college',label:'Before college'},
  {value:'repayment',label:'Repayment'},
  {value:'forgiveness',label:'Forgiveness'},
  {value:'special',label:'Special cases'},
];
---
<Base title="Free Student Loan Tools and College Cost Calculators" description="Choose the right free LoanLens tool: compare college costs, student loan repayment plans, RAP payments, deadlines or PSLF progress." og="tools">
  <header class="resource-hero resource-hero-slim page-hero">
    <div class="resource-hero-copy">
      <span class="eyebrow page-hero-kicker">LoanLens toolkit</span>
      <h1>Find the right student loan tool.</h1>
      <p>Compare college costs, estimate loan payments, check deadlines or track progress. Choose a question and go straight to the matching tool.</p>
      <div class="hero-actions">
        <a class="primary button-link" href="#find-a-tool">Help me choose</a>
        <a class="secondary button-link" href="#browse-tools">Browse all 7 tools</a>
      </div>
      <p class="hero-microcopy">Free · No account required · Independent educational estimates</p>
    </div>
  </header>

  <GoalFinder id="find-a-tool" mode="tools"/>

  <section id="browse-tools" class="resource-section page-section" aria-labelledby="browse-tools-title">
    <div class="resource-section-head">
      <div><span class="eyebrow">All calculators and helpers</span><h2 id="browse-tools-title">Browse every tool</h2></div>
      <p>Search by question or filter by topic. Every card explains when to use the tool and exactly what it shows.</p>
    </div>
    <ResourceExplorer label="Browse LoanLens planning tools" items={resources} topics={topics} placeholder="Try: aid offers, monthly payment, PSLF…" />
  </section>

  <section class="resource-split page-section" aria-labelledby="tools-before-title">
    <div>
      <span class="eyebrow">Before you start</span>
      <h2 id="tools-before-title">Have the right numbers handy.</h2>
      <p>You can test a hypothetical scenario first. For a more useful estimate, check your records rather than guessing.</p>
    </div>
    <div class="resource-prep-grid">
      <article class="resource-prep"><strong>Comparing colleges?</strong><p>Find each school's cost of attendance, grants, scholarships, and loans you expect to accept.</p><a href="/guides/compare-college-financial-aid-offers/">How to read an award letter</a></article>
      <article class="resource-prep"><strong>Already have loans?</strong><p>Find the balance, annual interest rate, loan type, and payment history for each loan.</p><a href="/guides/compare-student-loan-repayment/">What to compare in a plan</a></article>
    </div>
  </section>

  <section class="resource-note" aria-label="Important limitation">
    <strong>Your result is a starting point, not an eligibility decision.</strong>
    <p>LoanLens does not connect to your loan account or submit applications. Rules change and some calculations use approximations. Read the <a href="/guides/faq/">common questions</a>, check the <a href="/sources/">sources and assumptions</a>, and compare with the <a href="https://studentaid.gov/articles/repayment-calculator/">official Federal Student Aid Repayment Calculator</a>.</p>
  </section>
</Base>
