---
interface Resource {
  href: string;
  title: string;
  description: string;
  forYou?: string;
  outcome?: string;
  topic: string;
  kind: string;
  detail?: string;
  featured?: boolean;
}
interface Props {
  label: string;
  items: Resource[];
  topics: { value: string; label: string }[];
  placeholder?: string;
}
const { label, items, topics, placeholder='Search by topic or question' } = Astro.props;
---
<section class="resource-explorer" aria-label={label} data-resource-explorer>
  <div class="resource-filter-bar">
    <label class="resource-search">
      <span class="resource-search-label">Find what you need</span>
      <input type="search" placeholder={placeholder} autocomplete="off" data-resource-search />
    </label>
    <div class="resource-filter-row" role="group" aria-label="Filter by topic">
      <button class="resource-filter is-active" type="button" data-topic="all" aria-pressed="true">All topics</button>
      {topics.map(topic => <button class="resource-filter" type="button" data-topic={topic.value} aria-pressed="false">{topic.label}</button>)}
    </div>
  </div>
  <p class="resource-count" aria-live="polite" data-resource-count>
    Showing {items.length} {items.length===1?'resource':'resources'}
  </p>
  <div class="resource-grid" data-resource-grid>
    {items.map(item => <a
      href={item.href}
      class:list={['resource-card', {'resource-card-featured':item.featured}]}
      data-resource-card
      data-topic={item.topic}
      data-search={`${item.title} ${item.description} ${item.forYou??''} ${item.outcome??''} ${item.kind} ${item.detail??''}`.toLowerCase()}
    >
      <span class="resource-card-top">
        <span class="resource-card-type">{item.kind}</span>
        {item.detail && <span class="resource-card-detail">{item.detail}</span>}
      </span>
      <strong>{item.title}</strong>
      <span class="resource-card-description">{item.description}</span>
      {(item.forYou || item.outcome) && <span class="resource-card-answers">
        {item.forYou && <span><b>Good fit if</b>{item.forYou}</span>}
        {item.outcome && <span><b>You will see</b>{item.outcome}</span>}
      </span>}
      <span class="resource-card-open">Explore resource <span aria-hidden="true">↗</span></span>
    </a>)}
  </div>
  <div class="resource-empty" data-resource-empty hidden>
    <strong>No matching resources.</strong>
    <p>Try a different keyword or select All topics.</p>
    <button type="button" class="secondary" data-resource-clear>Clear filters</button>
  </div>
</section>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-resource-explorer]')) {
    const search = section.querySelector<HTMLInputElement>('[data-resource-search]');
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('.resource-filter')];
    const cards = [...section.querySelectorAll<HTMLElement>('[data-resource-card]')];
    const count = section.querySelector<HTMLElement>('[data-resource-count]');
    const empty = section.querySelector<HTMLElement>('[data-resource-empty]');
    const clear = section.querySelector<HTMLButtonElement>('[data-resource-clear]');
    let active = 'all';
    const apply = () => {
      const term = (search?.value ?? '').trim().toLocaleLowerCase('en-US');
      let matches = 0;
      for (const card of cards) {
        const visible = (active === 'all' || card.dataset.topic === active) &&
          (term === '' || (card.dataset.search ?? '').includes(term));
        card.hidden = !visible;
        if (visible) matches++;
      }
      for (const button of buttons) {
        const selected = button.dataset.topic === active;
        button.setAttribute('aria-pressed', String(selected));
        button.classList.toggle('is-active', selected);
      }
      if (count) count.textContent = 'Showing ' + matches + ' of ' + cards.length + ' resources';
      if (empty) empty.hidden = matches !== 0;
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      active = button.dataset.topic ?? 'all';
      apply();
    }));
    search?.addEventListener('input', apply);
    clear?.addEventListener('click', () => {
      active = 'all';
      if (search) search.value = '';
      apply();
      search?.focus();
    });
    apply();
  }
</script>
