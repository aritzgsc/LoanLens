---
import Base from '../layouts/Base.astro';
import Tools, { toolTitles } from './Tools';
import type { Tool } from './Tools';
interface Props { kind:Tool; }
const {kind}=Astro.props;
const {title,description}=toolTitles[kind];
const context:Record<Tool,{
  question:string;
  need:string;
  plain:string;
  example:string;
  reading:string;
  limitation:string;
  guide:string;
  guideLabel:string;
  next:string;
}> = {
  deadlines:{
    question:'Which dates and notices should I check?',
    need:'Your current repayment plan and, if you have a SAVE notice, the date and notice type.',
    plain:'A servicer is the company that manages billing and notices for your federal loan. Use the date printed in its message, not a date you remember.',
    example:'If you received a transition notice, select the notice type and enter the exact date on it. The tool gives a date to double-check, not a new official deadline.',
    reading:'Use the result as a reminder to check the exact deadline in your servicer message. The notice itself controls if the dates differ.',
    limitation:'The tool does not read your inbox, application status, or account-specific notices.',
    guide:'/guides/prepare-for-student-loan-repayment/',
    guideLabel:'Prepare for repayment',
    next:'Check the real notice and save its deadline in your calendar.'
  },
  married:{
    question:'How might filing jointly or separately change a RAP estimate?',
    need:'Both spouses’ annual adjusted gross income, eligible balances and dependent counts for each filing scenario.',
    plain:'AGI means adjusted gross income from a tax return. It is not the amount you take home each month. RAP refers to the Repayment Assistance Plan.',
    example:'If both partners have incomes, enter each annual AGI and eligible loan balance. Compare the displayed amounts, then check any joint tax consequences separately.',
    reading:'Look at the two modeled monthly figures. The result covers one borrower, not both spouses’ combined payments or the tax impact.',
    limitation:'This comparison does not advise which filing status to choose or verify eligibility.',
    guide:'/guides/compare-student-loan-repayment/',
    guideLabel:'Compare repayment costs',
    next:'Compare the household’s combined payment and tax implications with a qualified adviser.'
  },
  parent:{
    question:'What should I verify about Parent PLUS consolidation?',
    need:'The consolidation loan’s actual disbursement date and whether an ICR payment is recorded on that loan.',
    plain:'Parent PLUS loans are federal loans taken out by parents for a student. Consolidation combines eligible federal loans into a new consolidation loan, which has its own records.',
    example:'If your Parent PLUS loan was consolidated, find the new loan’s disbursement date on your official record before choosing an answer.',
    reading:'Use the questions and next step shown to prepare for a conversation with your loan servicer.',
    limitation:'An online checklist cannot establish eligibility or override program transition dates.',
    guide:'/guides/prepare-for-student-loan-repayment/',
    guideLabel:'Read the repayment checklist',
    next:'Check your loan history and ask the servicer which repayment options are open.'
  },
  pslf:{
    question:'How far away might the 120-payment milestone be?',
    need:'The certified qualifying-payment count for one loan and the next expected qualifying payment month.',
    plain:'PSLF stands for Public Service Loan Forgiveness. A qualifying-payment count is the count shown in your official record for a particular loan.',
    example:'If your official record lists 84 qualifying payments for one loan, the illustrative tracker starts with 36 periods remaining toward 120.',
    reading:'The target month is illustrative and assumes future payment periods qualify. Different loans may have different counts.',
    limitation:'LoanLens cannot certify an employer, validate payment history or grant forgiveness.',
    guide:'/guides/pslf-payment-count-checklist/',
    guideLabel:'Understand PSLF counts',
    next:'Verify the count for each loan and use the official PSLF Help Tool.'
  },
  income:{
    question:'What happens to a starting RAP estimate across income ranges?',
    need:'The number of dependents you expect to claim on the return used for the illustration.',
    plain:'RAP is the Repayment Assistance Plan. AGI is adjusted gross income on a tax return; the table uses sample income figures, not your actual loan balance.',
    example:'Change the dependent count from 0 to 2 and compare the sample monthly estimates at the same income row.',
    reading:'Use the table to compare sample incomes, not to determine an exact account payment or plan eligibility.',
    limitation:'The table uses sample AGIs and omits some account and household factors.',
    guide:'/guides/compare-student-loan-repayment/',
    guideLabel:'Learn to compare payments',
    next:'Enter your actual balances and other details in a broader calculator, then verify the result.'
  },
};
const info=context[kind];
---
<Base {title} {description} og={kind}>
  <header class="hero tool-detail-hero">
    <a class="tool-back" href="/tools/">← All planning tools</a>
    <span class="eyebrow">Interactive planning tool</span>
    <h1>{title}</h1>
    <p>{description}</p>
    <a class="primary button-link tool-start" href="#tool-workspace">Use this tool <span aria-hidden="true">↓</span></a>
    <div class="tool-brief">
      <div><span class="tool-brief-label">The question</span><strong>{info.question}</strong></div>
      <div><span class="tool-brief-label">What to have ready</span><strong>{info.need}</strong></div>
      <div><span class="tool-brief-label">What you will see</span><strong>{info.reading}</strong></div>
    </div>
  </header>
  <details class="tool-plain-help">
    <summary>New to these terms? See a plain-English explanation and example</summary>
    <div><p>{info.plain}</p><p><strong>Try it:</strong> {info.example}</p></div>
  </details>
  <section class="tool-workspace" id="tool-workspace" aria-labelledby="tool-workspace-heading">
    <div class="tool-workspace-heading">
      <div><span class="eyebrow">Interactive tool</span><h2 id="tool-workspace-heading">Try it with your numbers</h2></div>
      <p>Enter the details you know. Read the explanation below to interpret your estimate.</p>
    </div>
    <Tools client:load {kind}/>
  </section>
  <section class="tool-explain" aria-labelledby="tool-read-result">
    <div class="resource-section-head">
      <div><span class="eyebrow">Make sense of your estimate</span><h2 id="tool-read-result">What to do with the result</h2></div>
      <p>The tool is designed to help you ask better questions, not replace information held by Federal Student Aid.</p>
    </div>
    <div class="tool-explain-grid">
      <article class="tool-explain-card"><span class="tool-explain-number">01</span><h3>Read the estimate</h3><p>{info.reading}</p></article>
      <article class="tool-explain-card"><span class="tool-explain-number">02</span><h3>Know the limit</h3><p>{info.limitation}</p></article>
      <article class="tool-explain-card"><span class="tool-explain-number">03</span><h3>Take the next step</h3><p>{info.next}</p></article>
    </div>
    <div class="tool-related-cta">
      <div><strong>Want more context?</strong><p>Read the explanation or compare a fuller repayment scenario.</p></div>
      <div class="tool-related-actions">
        <a class="secondary button-link" href={info.guide}>{info.guideLabel}</a>
        <a class="primary button-link" href="/calculator/">Compare repayment plans</a>
      </div>
    </div>
  </section>
</Base>
