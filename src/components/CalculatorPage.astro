---
import Calculator from './Calculator';
import AdSlot from './AdSlot.astro';
import PartnerOffers from './PartnerOffers.astro';
import { entryPath, visible } from '../lib/content';
interface Props { title: string; description?: string; embedded?: boolean; }
const { title, embedded = false } = Astro.props;
const entries = await visible();
const nextSteps = [
  { href:'/tools/compare-college-aid-offers/', title:'Compare college aid offers', description:'See what each college costs after grants, scholarships, and loans.' },
  { href:'/guides/compare-student-loan-repayment/', title:'Compare repayment costs', description:'Understand monthly payments, repayment length, and total paid before choosing a plan.' },
  { href:'/rap-payment-by-income/', title:'RAP payment calculator by income', description:'Estimate a starting monthly RAP payment from AGI and dependents, and compare income brackets.' },
  { href:'/deadlines/', title:'Repayment deadlines', description:'Find which dates apply to your loans and repayment plan.' },
  ...[
    ['save-ended-what-now','SAVE ended: what now?','Find your notice deadline and compare replacement plans.'],
    ['rap-and-pslf','Does RAP count for PSLF?','Check how RAP payments can count toward public service forgiveness.'],
  ].flatMap(([id,title,description]) => {
    const entry = entries.find(page => page.id === id && page.data.category === 'guide');
    return entry ? [{ href:entryPath(entry), title, description }] : [];
  }),
];
---
<header id={embedded ? 'repayment-estimator' : undefined} class:list={['hero','hero-calculator','page-hero',{'page-hero-embedded':embedded}]}>
  <span class="eyebrow page-hero-kicker">Repayment estimate · 3 steps</span>
  {embedded ? <h2>{title}</h2> : <h1>{title}</h1>}
  <p>Enter a loan balance and rate to compare monthly payments, lifetime costs and projected repayment dates.</p>
</header>
<Calculator client:load />
<AdSlot kind="results" />
<PartnerOffers />
<section class="support page-section"><h2>Explore your next step</h2><div class="guide-grid">
  {nextSteps.map(step => <a class="guide-link" href={step.href}><strong>{step.title}</strong><span>{step.description}</span></a>)}
</div></section>
