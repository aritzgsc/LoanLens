---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { author, trustLinks } from '../lib/site';
import { entryPath, visible } from '../lib/content';
interface Props { entry:CollectionEntry<'pages'>; }
const {entry}=Astro.props;
const { Content, headings }=await render(entry);
const {title,description,category,status,updated,verified,reviewed,related,shortAnswer}=entry.data;
const draft=status==='draft';
const guide=category==='guide';
const entries=(await visible()).filter(e=>e.id!==entry.id && e.data.category==='guide');
const relatedEntries=entries.filter(e=>related.includes(e.id));
const suggestions=(relatedEntries.length?relatedEntries:entries).slice(0,3);
const contents = headings.filter(heading=>heading.depth===2);
const nextTools:Record<string,{href:string;title:string;description:string}>={
  'compare-college-financial-aid-offers':{href:'/tools/compare-college-aid-offers/',title:'Compare two aid offers',description:'Test the calculations from this guide with two annual college offers.'},
  'understand-college-aid-types':{href:'/tools/compare-college-aid-offers/',title:'Compare college costs',description:'Separate gift aid from planned loans and the remaining gap.'},
  'compare-student-loan-repayment':{href:'/calculator/',title:'Compare repayment plans',description:'Look at projected starting payments, total paid and payoff dates.'},
  'student-loan-interest-explained':{href:'/calculator/',title:'Test an interest scenario',description:'See how the modeled payment and interest cost vary by balance and rate.'},
  'prepare-for-student-loan-repayment':{href:'/calculator/',title:'Estimate your repayment',description:'Use the figures you gathered from your account to compare illustrative outcomes.'},
  'pslf-payment-count-checklist':{href:'/tools/pslf-payment-tracker/',title:'Track a PSLF milestone',description:'Enter a certified count for one loan to estimate a target month.'},
};
const nextTool=nextTools[entry.id]??{href:'/tools/',title:'Explore related tools',description:'Find the next planning step for this topic.'};
const trustSummaries:Record<string,{eyebrow:string;summary:string;focus:string}> = {
  about:{eyebrow:'About this project',summary:'Free student loan and college aid tools built to help you compare options without marketing pressure.',focus:'Independent information, not a loan provider.'},
  contact:{eyebrow:'Feedback and corrections',summary:'Report broken links, incorrect calculations or confusing explanations through the public issue tracker.',focus:'Never post personal financial details in a public issue.'},
  privacy:{eyebrow:'Privacy at LoanLens',summary:'Know what stays in your browser, how shared scenario links work and what hosting or ads may process.',focus:'Avoid placing private information in shared links.'},
  sources:{eyebrow:'Research and references',summary:'See the official publications and documented assumptions used to build LoanLens estimates.',focus:'Account-specific decisions still require official verification.'},
  'editorial-policy':{eyebrow:'How our content is reviewed',summary:'How calculations are sourced, tested, updated and corrected when a problem is reported.',focus:'Tests reduce errors but cannot guarantee every outcome.'},
  advertising:{eyebrow:'Ads and independence',summary:'Understand how advertising is kept separate from the estimates and what privacy controls may appear.',focus:'Advertisements are never a repayment recommendation.'},
  disclaimer:{eyebrow:'Scope and limitations',summary:'What your estimate can show—and why it cannot replace your loan servicer or an official eligibility decision.',focus:'Always verify amounts and deadlines before acting.'},
  terms:{eyebrow:'Use of this site',summary:'The basic conditions for using educational estimates and third-party links.',focus:'LoanLens does not change or manage any loan account.'},
  accessibility:{eyebrow:'Accessibility support',summary:'How to report an accessibility barrier, and how to find readable alternatives to chart data.',focus:'Public bug reports should never include private account information.'}
};
const trustInfo=trustSummaries[entry.id]??{eyebrow:'LoanLens information',summary:description,focus:'Check official sources for account-specific decisions.'};
const publishedTrustIds=new Set((await visible()).filter(e=>e.data.category==='trust').map(e=>e.id));
const trustNavigation=trustLinks.filter(([id])=>id!==entry.id && publishedTrustIds.has(id)).slice(0,5);

---
<Base {title} {description} kind={guide?'Article':undefined} {draft} {updated} og={category+'-'+entry.id}>
  <div class:list={['editorial-frame',{'trust-page':!guide}]}>
  <header class:list={['hero',{'trust-hero':!guide}]}>
    {!guide && <span class="eyebrow">{trustInfo.eyebrow}</span>}
    <h1>{title}</h1>
    <p>{guide?description:trustInfo.summary}</p>
  {guide && <p class="editorial-meta">{!author.name.includes('{{') && <>Published by {author.name} <span aria-hidden="true">·</span> </>}Updated <time datetime={updated}>{updated}</time>{verified!==updated && <> <span aria-hidden="true">·</span> Last verified <time datetime={verified}>{verified}</time></>}{reviewed && reviewed!==updated && reviewed!==verified && <> <span aria-hidden="true">·</span> Reviewed <time datetime={reviewed}>{reviewed}</time></>}</p>}
    {!guide && <div class="trust-hero-meta"><span>Independent educational reference</span><span aria-hidden="true">·</span><span>Reviewed <time datetime={reviewed??updated}>{reviewed??updated}</time></span></div>}
    {draft && <p class="warning">Editorial draft awaiting review.</p>}
  </header>
  <div class:list={['article-columns',{'trust-columns':!guide}]}>
    <article class:list={['article-body',{'trust-article':!guide}]}>
    {!guide && <div class="trust-key-point"><span aria-hidden="true">✓</span><p>{trustInfo.focus}</p></div>}
    {!guide && contents.length>1 && <nav class="trust-mobile-toc" aria-label="Sections on this page"><strong>On this page</strong><ol>{contents.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav>}
    {guide && shortAnswer && <section class="short-answer notice" aria-labelledby="short-answer"><h2 id="short-answer">Short answer</h2><p>{shortAnswer}</p></section>}
    {guide && contents.length>2 && <nav class="article-toc" aria-label="On this page">
      <strong>In this guide</strong>
      <ol>{contents.map(heading=><li><a href={'#'+heading.slug}>{heading.text}</a></li>)}</ol>
    </nav>}
    <Content/>
    {guide && <div class="article-next">
      <span class="eyebrow">Put it into practice</span>
      <h2>{nextTool.title}</h2>
      <p>{nextTool.description}</p>
      <a class="primary button-link" href={nextTool.href}>Try the matching tool</a>
    </div>}
  </article>
    {guide && <aside><AdSlot kind="sidebar"/></aside>}
    {!guide && <aside class="trust-sidebar" aria-label="More about LoanLens">
      {contents.length>1 && <nav class="trust-sidebar-block trust-on-this-page" aria-label="On this page"><strong>On this page</strong><ol>{contents.map(h=><li><a href={'#'+h.slug}>{h.text}</a></li>)}</ol></nav>}
      <nav class="trust-sidebar-block" aria-label="Useful policies and information">
        <strong>Related information</strong>
        <ul>{trustNavigation.map(([id,label])=><li><a href={'/'+id+'/'}>{label}<span aria-hidden="true">↗</span></a></li>)}</ul>
      </nav>
      <div class="trust-sidebar-note"><strong>Need an account-specific answer?</strong><p>For your actual student loan, consult Federal Student Aid or your servicer.</p><a href="https://studentaid.gov/" rel="noopener noreferrer">Visit StudentAid.gov <span aria-hidden="true">↗</span></a></div>
    </aside>}
  </div>
  {guide && <section class="support"><h2>Related tools and guides</h2><div class="guide-grid">
  <a class="guide-link" href="/calculator/"><strong>Compare repayment plans</strong><span>See your estimated monthly payments and total costs.</span></a>
    {suggestions.map(e=><a class="guide-link" href={entryPath(e)}><strong>{e.data.title}</strong><span>{e.data.description}</span></a>)}
  </div></section>}
  {!guide && <section class="trust-next" aria-labelledby="trust-next-title">
    <div class="trust-next-intro">
      <span class="eyebrow">Your next step</span><h2 id="trust-next-title">Explore with more confidence.</h2>
      <p>Understand the estimates, verify the assumptions and choose a useful starting point.</p>
    </div>
    <div class="trust-next-grid">
      <a href="/calculator/"><strong>Estimate a loan payment</strong><span>See the numbers behind a repayment scenario.</span><span class="trust-next-arrow" aria-hidden="true">↗</span></a>
      <a href="/sources/"><strong>Check the sources</strong><span>Explore official references and modeling limits.</span><span class="trust-next-arrow" aria-hidden="true">↗</span></a>
      <a href={entry.id==='contact'?'/editorial-policy/':'/contact/'}><strong>{entry.id==='contact'?'How corrections work':'Report an issue'}</strong><span>{entry.id==='contact'?'Learn how updates and corrections are managed.':'Share a correction safely through the public tracker.'}</span><span class="trust-next-arrow" aria-hidden="true">↗</span></a>
    </div>
  </section>}
  </div>
</Base>
