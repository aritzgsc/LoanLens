---
import '../styles/site.css';
import { author, publisher, robotsNoIndex, siteName, trustLinks, validPublisher } from '../lib/site';
import { visible } from '../lib/content';
interface Props { title:string; description:string; kind?:'WebApplication'|'Article'; draft?:boolean; updated?:string; og?:string; }
const {title,description,kind,draft=false,updated,og='home'} = Astro.props;
const root = Astro.site ?? new URL('https://loanlens.example');
const canonical = new URL(Astro.url.pathname,root);
const ogImage = new URL('/og/'+og+'.png',root);
const noindex = draft || robotsNoIndex || Astro.url.pathname.startsWith('/404');
const guides = await visible();
const trust = trustLinks.filter(([slug])=>guides.some(entry=>entry.id===slug && entry.data.category==='trust'));
const footerAbout = trust.filter(([slug])=>['about','contact','editorial-policy','sources'].includes(slug));
const footerPolicies = trust.filter(([slug])=>['privacy','terms','disclaimer','accessibility','advertising'].includes(slug));
const segments = Astro.url.pathname.split('/').filter(Boolean);
const slug = segments[0];
const navigation = [['/calculator/','Calculator'], ['/deadlines/','Deadlines'], ['/tools/','Tools'], ['/guides/','Guides']] as const;
const groups: Record<string,string> = {guides:'Guides',tools:'Tools'};
const crumbs = segments.length > 1 && groups[segments[0]] ? [{title:groups[segments[0]],url:'/'+segments[0]+'/'}] : [];
const breadcrumb = [{title:'Home',url:'/'},...crumbs,{title,url:Astro.url.pathname}];
const schema = {'@context':'https://schema.org','@graph':[
  {'@type':'WebSite','@id':new URL('/#website',root).href,name:siteName,url:root.href},
  {'@type':'Organization','@id':new URL('/#organization',root).href,name:siteName,url:root.href,logo:new URL('/icon.svg',root).href},
  {'@type':'WebPage','@id':canonical.href+'#webpage',url:canonical.href,name:title,description,
    inLanguage:'en-US',isPartOf:{'@id':new URL('/#website',root).href},
    primaryImageOfPage:{'@type':'ImageObject',url:ogImage.href}},
  ...(segments.length?[{'@type':'BreadcrumbList',itemListElement:breadcrumb.map((b,i)=>({'@type':'ListItem',position:i+1,name:b.title,item:new URL(b.url,root).href}))}]:[]),
  ...(kind?[{'@type':kind,name:title,headline:title,description,url:canonical.href,image:ogImage.href,
      ...(kind==='Article'?{dateModified:updated,...(!author.name.includes('{{') && {author:{'@type':'Person',name:author.name}}),publisher:{'@id':new URL('/#organization',root).href}}:
      {applicationCategory:'FinanceApplication',operatingSystem:'Any',isAccessibleForFree:true,offers:{'@type':'Offer',price:0,priceCurrency:'USD'}})}]:[])
]};
const cmp = import.meta.env.PUBLIC_GOOGLE_CMP_URL || '';
const policiesPublished = ['privacy','advertising'].every(id=>guides.some(e=>e.id===id && e.data.status==='reviewed'));
const cmpUrl = !robotsNoIndex && policiesPublished && validPublisher && /^https:\/\/fundingchoicesmessages\.google\.com\//.test(cmp) ? cmp : '';
---
<!doctype html>
<html lang="en-US">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title.length + siteName.length + 3 < 60 ? title + ' | ' + siteName : title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content={noindex?'noindex, follow':'index, follow'} />
  <link rel="canonical" href={canonical.href} />
  <link rel="icon" type="image/svg+xml" href="/icon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content={kind==='Article'?'article':'website'} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content={siteName} />
  <meta property="og:locale" content="en_US" />
  <meta property="og:url" content={canonical.href} />
  <meta property="og:image" content={ogImage.href} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage.href} />
  {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION}/>}
  {import.meta.env.PUBLIC_BING_SITE_VERIFICATION && <meta name="msvalidate.01" content={import.meta.env.PUBLIC_BING_SITE_VERIFICATION}/>}
  {!noindex && validPublisher && <meta name="google-adsense-account" content={publisher}/>}
  <script type="application/ld+json" set:html={JSON.stringify(schema).replaceAll('<','\\u003c')} />
  {cmpUrl && <>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent','default',{ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',analytics_storage:'denied'});
    </script>
    <script is:inline define:vars={{cmpUrl}}>
      if (!location.hash.startsWith('#scenario=')) {
        const cmp = document.createElement('script');
        cmp.async = true;
        cmp.src = cmpUrl;
        document.head.append(cmp);
      }
    </script>
  </>}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <header class="site-head"><div class="shell">
    <a class="brand" href="/"><img src="/icon.svg" width="34" height="34" alt="" />{siteName}</a>
    <nav class="site-nav" aria-label="Main navigation">
      {navigation.map(([url, label]) => <a href={url} aria-current={Astro.url.pathname === url ? 'page' : slug && url === '/' + slug + '/' ? 'location' : undefined}>{label}</a>)}
    </nav>
    <details class="mobile-nav" data-mobile-nav>
      <summary><span class="mobile-nav-icon" aria-hidden="true"><span></span><span></span><span></span></span><span>Menu</span></summary>
      <nav class="mobile-nav-panel" aria-label="Mobile navigation">
        <a href="/" aria-current={Astro.url.pathname==='/'?'page':undefined}>Home</a>
        {navigation.map(([url,label])=><a href={url} aria-current={Astro.url.pathname===url?'page':slug&&url==='/'+slug+'/'?'location':undefined}>{label}</a>)}
        <a class="mobile-nav-extra" href="/guides/faq/">Common questions</a>
      </nav>
    </details>
  </div></header>
  <main id="main" class="shell">
    {segments.length>0 && <nav class="crumbs" aria-label="Breadcrumb"><ol>{breadcrumb.map((b,i)=><li>{i===breadcrumb.length-1?<span aria-current="page">{b.title}</span>:<a href={b.url}>{b.title}</a>}</li>)}</ol></nav>}
    <slot />
  </main>
  <footer class="site-footer">
    <div class="shell">
      <div class="footer-main">
        <div class="footer-intro">
          <a class="footer-brand" href="/" aria-label="LoanLens home">
            <img src="/icon.svg" width="38" height="38" alt="" /><span>{siteName}</span>
          </a>
          <p>Student loan decisions become clearer when the numbers make sense. Free calculators, practical guides and transparent assumptions.</p>
          <a href="/calculator/" class="footer-action">Open loan calculator <span aria-hidden="true">↗</span></a>
        </div>
        <div class="footer-menus">
          <nav class="footer-menu" aria-label="Explore LoanLens">
            <h2>Explore</h2>
            <a href="/calculator/">Loan calculator</a>
            <a href="/deadlines/">Repayment deadlines</a>
            <a href="/tools/">All tools</a>
            <a href="/guides/">Guides</a>
            <a href="/guides/faq/">Common questions</a>
          </nav>
          <nav class="footer-menu" aria-label="About LoanLens">
            <h2>About LoanLens</h2>
            {footerAbout.map(([slug,label])=><a href={'/'+slug+'/'}>{label}</a>)}
          </nav>
          <nav class="footer-menu" aria-label="Legal and transparency">
            <h2>Legal &amp; transparency</h2>
            {footerPolicies.map(([slug,label])=><a href={'/'+slug+'/'}>{label}</a>)}
            {cmpUrl && <button class="footer-privacy" type="button" data-ad-privacy>Advertising privacy choices</button>}
          </nav>
        </div>
      </div>
      <div class="footer-bottom">
        <p>Independent educational information, not financial, tax or legal advice. LoanLens is not a government service or lender.</p>
        <a href="https://studentaid.gov/loan-simulator/" rel="noopener noreferrer">Official Federal Student Aid simulator <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </footer>
  {cmpUrl && <script src="/ads-consent.js" defer is:inline></script>}
  <script>
    const mobileNav = document.querySelector<HTMLDetailsElement>('[data-mobile-nav]');
    if (mobileNav) {
      mobileNav.addEventListener('keydown', event => {
        if (event.key === 'Escape' && mobileNav.open) {
          mobileNav.open = false;
          mobileNav.querySelector('summary')?.focus();
        }
      });
      document.addEventListener('pointerdown', event => {
        if (mobileNav.open && event.target instanceof Node && !mobileNav.contains(event.target)) mobileNav.open = false;
      });
      mobileNav.querySelectorAll('a').forEach(anchor => anchor.addEventListener('click', () => { mobileNav.open = false; }));
      window.matchMedia('(min-width: 721px)').addEventListener('change', event => { if (event.matches) mobileNav.open = false; });
    }
  </script>
</body>
</html>
